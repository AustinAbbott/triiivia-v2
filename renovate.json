{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":automergeRequireAllStatusChecks",
    "schedule:weekly",
    ":maintainLockFilesMonthly",
    "group:allNonMajor"
  ],
  "constraints": {
    "npm": "^10"
  },
  "minimumReleaseAge": "3 days",
  "commitMessagePrefix": "🔧",
  "lockFileMaintenance": {
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Automerge minor, patch and digest updates when checks pass",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    },
    {
      "description": "Hold major upgrades until the move from Create React App to Vite",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
